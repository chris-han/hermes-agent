      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "idempotency_key"
      ],
      "title": "ChannelControl",
      "type": "object"
