    "FeedbackAuthorization": {
      "additionalProperties": false,
      "properties": {
        "intent_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Intent Ref",
          "type": "string"
        },
        "proof_challenge": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Proof Challenge",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "diagnostic",
            "reporting"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "profile_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Profile Ref",
          "type": "string"
        }
      },
      "required": [
        "intent_ref",
        "proof_challenge",
        "purpose",
        "profile_ref"
      ],
      "title": "FeedbackAuthorization",
      "type": "object"
    },
    "FeedbackProof": {
      "additionalProperties": false,
      "properties": {
        "proof": {
          "maxLength": 128,
          "minLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Proof",
          "type": "string"
        }
      },
      "required": [
        "proof"
      ],
      "title": "FeedbackProof",
      "type": "object"
    },
    "FeedbackDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "decision"
      ],
      "title": "FeedbackDecision",
      "type": "object"
    }
  }
