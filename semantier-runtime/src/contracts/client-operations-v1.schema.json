            },
            "target_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Target Sha256",
              "type": "string"
            },
            "from_version": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "title": "From Version",
              "type": "string"
