{
  "contract": "semantier-client-operations/v1",
  "version": "1.1.0",
  "schemas": {
    "UpdateEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "update_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Update Id",
          "type": "string"
        },
        "installation_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Installation Ref",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "target_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Sha256",
          "type": "string"
        },
        "from_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "From Version",
          "type": "string"
        },
        "target_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Target Version",
          "type": "string"
        },
        "package_family": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Package Family",
          "type": "string"
        },
        "stage": {
          "enum": [
            "check",
            "download",
            "verify",
            "handoff",
            "restart_confirmation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pending",
            "unknown",
            "failed",
            "target_confirmed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "occurred_at": {
          "title": "Occurred At",
          "type": "string"
        },
        "observed_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Version"
        },
        "observed_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Family"
        },
        "observed_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Sha256"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "update_id",
        "installation_ref",
        "release_id",
        "target_sha256",
        "from_version",
        "target_version",
        "package_family",
        "stage",
        "outcome",
        "occurred_at"
      ],
      "title": "UpdateEvent",
      "type": "object"
    },
    "EventBatch": {
