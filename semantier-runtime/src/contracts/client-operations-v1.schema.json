                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Observed Family"
            },
            "observed_sha256": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Observed Sha256"
            }
          },
          "required": [
            "schema_version",
            "event_id",
            "update_id",
            "installation_ref",
            "release_id",
            "target_sha256",
            "from_version",
            "target_version",
            "package_family",
            "stage",
            "outcome",
            "occurred_at"
          ],
          "title": "UpdateEvent",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/UpdateEvent"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventBatch",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "submission_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Submission Key",
          "type": "string"
        },
        "app_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "App Version",
          "type": "string"
        },
        "release_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Id"
        },
        "update_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Id"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "platform": {
          "const": "win32",
          "title": "Platform",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 4000,
          "title": "Note",
          "type": "string"
        },
        "sections": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Sections",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "submission_key",
        "app_version",
        "platform",
        "sections"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "category": {
          "enum": [
            "unclassified",
            "startup",
            "update",
            "provider",
            "ui",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "unassessed",
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "new",
            "triaged",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "fix_release_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix Release Id"
        },
        "operator_note": {
          "default": "",
          "maxLength": 4000,
          "title": "Operator Note",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "category",
        "severity",
        "status"
      ],
      "title": "Classification",
      "type": "object"
    },
    "ReleaseCandidate": {
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "manifest": {
          "additionalProperties": true,
          "title": "Manifest",
          "type": "object"
        },
        "notes": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 9,
          "minProperties": 1,
          "title": "Notes",
          "type": "object"
        },
        "native_receipt": {
          "additionalProperties": true,
          "title": "Native Receipt",
          "type": "object"
        },
        "receipt_hmac": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Receipt Hmac",
          "type": "string"
        }
