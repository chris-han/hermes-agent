          "operation": "compare_general_and_role_knowledge_profiles",
          "checkpoint": {
            "kind": "OWNER_RESULT",
            "evidence": [
              "profile_id",
              "run_ref",
              "citation_ref",
              "gap_note"
            ]
          },
          "misconception": "Skill is authority",
          "transfer": "Record one miss, false positive, or rule gap."
        },
        {
          "id": "B3",
          "minutes": 10,
          "title": "Break",
          "activity": "BREAK",
          "checkpoint": {
            "kind": "BREAK"
          },
          "misconception": null,
