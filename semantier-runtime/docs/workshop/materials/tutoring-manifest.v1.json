          "transfer": "Name the owner of one capability."
        },
        {
          "id": "B1",
          "minutes": 35,
          "title": "Resume/JD + Prompt 对比",
          "activity": "DO",
          "materials": [
            "resume-sample-zh.md",
            "jd-sample-zh.md",
            "prompt-versions-handout-zh.md"
