          "operation": "upload_parse_and_compare_prompt_runs",
          "checkpoint": {
            "kind": "OWNER_RESULT",
            "evidence": [
              "source_hash",
              "parse_ref",
              "run_ref",
              "prompt_version"
            ]
          },
          "misconception": "better wording can justify unsupported facts",
          "transfer": "Explain one output difference using evidence."
        },
        {
          "id": "B2",
          "minutes": 30,
          "title": "Prompt + Skill",
          "activity": "EVALUATE",
